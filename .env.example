# Copy to .env for local use. Never commit your real .env file.
FACEBOOK_PAGE_ID=your_page_id_here
FACEBOOK_ACCESS_TOKEN=your_long_lived_page_access_token_here

# Optional settings
FACEBOOK_GRAPH_VERSION=v24.0
BIBLE_SOURCE=rss
POST_TIMEZONE=Africa/Blantyre
POSTER_DRY_RUN=true
POST_HASHTAGS=#BibleVerse #DailyVerse #Gospel #Faith #Jesus
MAX_POST_LENGTH=2000
REQUEST_TIMEOUT=30
POSTED_VERSES_FILE=data/posted_verses.json
